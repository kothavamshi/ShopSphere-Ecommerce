/* =====================================================
   HERO SECTION
===================================================== */

.hero {
    background: linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
    );

    border-radius: 20px;
    padding: 80px 50px;
    color: white;
    margin-bottom: 70px;
}

.hero-content {
    max-width: 700px;
}

.hero-tag {
    text-transform: uppercase;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 15px;
    opacity: 0.9;
}

.hero h1 {
    color: white;
    font-size: 52px;
    line-height: 1.1;
    margin-bottom: 20px;
}

.hero-description {
    font-size: 18px;
    max-width: 550px;
    margin-bottom: 30px;
    color: #e0e7ff;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}


/* =====================================================
   BUTTONS
===================================================== */

.btn {
    display: inline-block;
    padding: 11px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    transition: 0.2s ease;
}

.btn-primary {
    background: #2563eb;
    color: white;
}

.btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
}

.hero .btn-primary {
    background: white;
    color: #2563eb;
}

.hero .btn-primary:hover {
    background: #f1f5f9;
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.5);
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
}

.btn-outline {
    border: 1px solid #2563eb;
    color: #2563eb;
    background: white;
}

.btn-outline:hover {
    background: #eff6ff;
}

.btn-dark {
    background: #111827;
    color: white;
}

.btn-dark:hover {
    background: #1f2937;
}


/* =====================================================
   SECTION HEADING
===================================================== */

.featured-section {
    margin-bottom: 70px;
}

.section-heading {
    text-align: center;
    margin-bottom: 35px;
}

.section-label {
    color: #2563eb;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 34px;
    margin: 5px 0 8px;
}

.section-heading p:last-child {
    color: #64748b;
}


/* =====================================================
   PRODUCT GRID
===================================================== */

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.product-card {
    background: white;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    transition: 0.25s ease;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
}

.product-image {
    height: 220px;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 15px;
}

.no-image {
    color: #94a3b8;
}

.product-info {
    padding: 20px;
}

.product-info h3 {
    font-size: 18px;
    margin-bottom: 8px;
}

.product-description {
    color: #64748b;
    font-size: 14px;
    min-height: 45px;
}

.product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 18px 0;
}

.product-price {
    font-size: 20px;
    font-weight: bold;
    color: #2563eb;
}

.stock {
    font-size: 12px;
    font-weight: 600;
}

.available {
    color: #16a34a;
}

.unavailable {
    color: #dc2626;
}

.product-actions {
    display: flex;
    gap: 8px;
}

.product-actions .btn {
    flex: 1;
    text-align: center;
    padding: 9px 8px;
    font-size: 13px;
}


/* =====================================================
   VIEW ALL
===================================================== */

.view-all {
    text-align: center;
    margin-top: 35px;
}


/* =====================================================
   FEATURES
===================================================== */

.features-section {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-bottom: 50px;
}

.feature {
    background: white;
    padding: 30px;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
    text-align: center;
}

.feature-icon {
    font-size: 25px;
    margin-bottom: 10px;
}

.feature h3 {
    margin-bottom: 8px;
}

.feature p {
    color: #64748b;
    font-size: 14px;
}


/* =====================================================
   RESPONSIVE HOMEPAGE
===================================================== */

@media (max-width: 1000px) {

    .product-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 700px) {

    .hero {
        padding: 55px 25px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .features-section {
        grid-template-columns: 1fr;
    }

}
/* =====================================================
   PRODUCTS PAGE
===================================================== */

.page-header {
    text-align: center;
    margin-bottom: 35px;
}

.page-header h1 {
    font-size: 38px;
    margin: 5px 0 10px;
}

.page-header > p:last-child {
    color: #64748b;
}


/* =====================================================
   FILTER BOX
===================================================== */

.filter-box {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 35px;
}

.product-filter {
    display: flex;
    align-items: center;
    gap: 12px;
}

.search-input {
    flex: 1;
}

.product-filter input,
.product-filter select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    background: white;
}

.product-filter input:focus,
.product-filter select:focus {
    border-color: #2563eb;
}

.product-filter select {
    min-width: 180px;
}

.product-filter .btn {
    border: none;
    cursor: pointer;
    white-space: nowrap;
}


/* =====================================================
   CATEGORY BADGE
===================================================== */

.category-badge {
    display: inline-block;
    background: #eff6ff;
    color: #2563eb;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 20px;
    margin-bottom: 10px;
}


/* =====================================================
   EMPTY STATE
===================================================== */

.empty-state {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-align: center;
    padding: 60px 20px;
}

.empty-state h2 {
    margin-bottom: 8px;
}

.empty-state p {
    color: #64748b;
}


/* =====================================================
   PRODUCTS RESPONSIVE
===================================================== */

@media (max-width: 700px) {

    .product-filter {
        flex-direction: column;
        align-items: stretch;
    }

    .product-filter select {
        min-width: 0;
    }

    .product-filter .btn {
        text-align: center;
    }

    .page-header h1 {
        font-size: 30px;
    }

}
/* =====================================================
   PRODUCT DETAILS
===================================================== */

.product-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 40px;
    margin-bottom: 30px;
}


/* Product Image */

.product-details-image {
    height: 430px;
    background: #f8fafc;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.product-details-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 30px;
}


/* Product Information */

.product-details-info h1 {
    font-size: 40px;
    margin: 10px 0 18px;
}

.details-description {
    color: #64748b;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 25px;
}

.details-price {
    font-size: 32px;
    font-weight: 700;
    color: #2563eb;
    margin-bottom: 15px;
}

.details-actions {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
}


/* Product Info Box */

.product-info-box {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 30px;
}

.product-info-box h2 {
    margin-bottom: 20px;
}

.info-row {
    display: flex;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: 1px solid #e2e8f0;
}

.info-row:last-child {
    border-bottom: none;
}


/* Responsive */

@media (max-width: 800px) {

    .product-details {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 25px;
    }

    .product-details-image {
        height: 320px;
    }

    .product-details-info h1 {
        font-size: 32px;
    }

    .details-price {
        font-size: 28px;
    }

    .info-row {
        gap: 20px;
    }

}
/* =====================================================
   CART PAGE
===================================================== */

.cart-page {
    width: 100%;
}


/* Cart Layout */

.cart-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 25px;
    align-items: start;
}


/* Cart Item */

.cart-item {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 15px;

    display: grid;
    grid-template-columns: 100px 1fr auto auto auto;
    gap: 20px;
    align-items: center;
}


/* Product Image */

.cart-item-image {
    width: 100px;
    height: 100px;
    background: #f8fafc;
    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;
}

.cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
}


/* Product Details */

.cart-item-details h2 {
    font-size: 17px;
    margin-bottom: 6px;
}

.cart-item-price {
    color: #2563eb;
    font-weight: 600;
}

.cart-stock {
    color: #64748b;
    font-size: 13px;
}


/* Quantity */

.quantity-label {
    display: block;
    font-size: 12px;
    color: #64748b;
    margin-bottom: 6px;
}

.quantity-controls {
    display: flex;
    align-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    overflow: hidden;
}

.quantity-controls strong {
    min-width: 35px;
    text-align: center;
}

.quantity-btn {
    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #1e293b;
    background: #f8fafc;

    font-size: 18px;
    font-weight: bold;
}

.quantity-btn:hover {
    background: #e2e8f0;
}

.quantity-btn.disabled {
    color: #cbd5e1;
    cursor: not-allowed;
}


/* Subtotal */

.cart-item-total span {
    display: block;
    font-size: 12px;
    color: #64748b;
}

.cart-item-total strong {
    font-size: 17px;
}


/* Remove */

.remove-item {
    color: #dc2626;
    font-size: 13px;
}

.remove-item:hover {
    text-decoration: underline;
}


/* Cart Summary */

.cart-summary {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 25px;

    position: sticky;
    top: 20px;
}

.cart-summary h2 {
    font-size: 21px;
    margin-bottom: 20px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    color: #64748b;
}

.summary-divider {
    height: 1px;
    background: #e2e8f0;
    margin: 18px 0;
}

.summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.summary-total strong {
    color: #2563eb;
    font-size: 23px;
}

.checkout-btn {
    width: 100%;
    text-align: center;
}

.continue-shopping {
    display: block;
    text-align: center;
    margin-top: 15px;
    color: #64748b;
    font-size: 14px;
}

.continue-shopping:hover {
    color: #2563eb;
}


/* Empty Cart */

.empty-cart {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    text-align: center;
    padding: 70px 20px;
}

.empty-cart-icon {
    font-size: 50px;
    margin-bottom: 15px;
}

.empty-cart h2 {
    margin-bottom: 8px;
}

.empty-cart p {
    color: #64748b;
    margin-bottom: 25px;
}


/* Responsive */

@media (max-width: 1000px) {

    .cart-layout {
        grid-template-columns: 1fr;
    }

    .cart-summary {
        position: static;
    }

}

@media (max-width: 700px) {

    .cart-item {
        grid-template-columns: 80px 1fr;
        gap: 15px;
    }

    .cart-item-image {
        width: 80px;
        height: 80px;
    }

    .cart-quantity,
    .cart-item-total,
    .remove-item {
        grid-column: 2;
    }

    .cart-item-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

}
/* =====================================================
   AUTH PAGES
===================================================== */

.auth-page {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

.auth-card {
    width: 100%;
    max-width: 460px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 35px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.auth-header {
    text-align: center;
    margin-bottom: 28px;
}

.auth-header h1 {
    font-size: 30px;
    margin: 5px 0 8px;
}

.auth-header p:last-child {
    color: #64748b;
}


/* =====================================================
   FORMS
===================================================== */

.auth-form,
.checkout-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.form-group label {
    font-size: 14px;
    font-weight: 600;
    color: #334155;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: 0.2s ease;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.form-group textarea {
    resize: vertical;
}

.form-submit {
    width: 100%;
    border: none;
    cursor: pointer;
    margin-top: 5px;
}

.auth-footer {
    text-align: center;
    margin-top: 22px;
    color: #64748b;
    font-size: 14px;
}

.auth-footer a {
    color: #2563eb;
    font-weight: 600;
}


/* =====================================================
   FORM MESSAGES
===================================================== */

.form-message {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 20px;
    font-size: 14px;
}

.form-message.error {
    background: #fef2f2;
    color: #991b1b;
    border-color: #fecaca;
}


/* =====================================================
   CHECKOUT
===================================================== */

.checkout-page {
    max-width: 750px;
    margin: 0 auto;
}

.checkout-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 30px;
}

.checkout-actions {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 10px;
}

.checkout-actions .btn {
    border: none;
    cursor: pointer;
}

.checkout-actions .btn-outline {
    border: 1px solid #2563eb;
}


/* =====================================================
   AUTH / CHECKOUT MOBILE
===================================================== */

@media (max-width: 600px) {

    .auth-card {
        padding: 25px 20px;
    }

    .checkout-card {
        padding: 22px;
    }

    .checkout-actions {
        flex-direction: column;
    }

    .checkout-actions .btn {
        width: 100%;
        text-align: center;
    }

}
/* =====================================================
   ADMIN DASHBOARD
===================================================== */

.admin-page {
    width: 100%;
}


/* Admin Header */

.admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
}

.admin-header h1 {
    margin-bottom: 5px;
}

.admin-header p:last-child {
    color: #64748b;
}


/* Statistics */

.dashboard-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 30px;
}

.stat-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 22px;
}

.stat-icon {
    font-size: 24px;
    margin-bottom: 12px;
}

.stat-card p {
    color: #64748b;
    font-size: 13px;
    margin-bottom: 5px;
}

.stat-card h2 {
    font-size: 27px;
    color: #111827;
}


/* Admin Actions */

.admin-actions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 30px;
}

.admin-action-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 22px;

    display: flex;
    align-items: center;
    gap: 18px;

    color: #1e293b;
    transition: 0.2s ease;
}

.admin-action-card:hover {
    border-color: #93c5fd;
    transform: translateY(-2px);
    box-shadow: 0 7px 20px rgba(0, 0, 0, 0.05);
}

.admin-action-icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #eff6ff;
    border-radius: 10px;

    font-size: 22px;
}

.admin-action-card h3 {
    margin-bottom: 3px;
}

.admin-action-card p {
    color: #64748b;
    font-size: 13px;
}


/* Admin Section */

.admin-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
}

.admin-section-header {
    padding: 22px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e2e8f0;
}

.admin-section-header h2 {
    margin-bottom: 3px;
}

.admin-section-header p {
    color: #64748b;
    font-size: 13px;
}


/* Table */

.admin-table-wrapper {
    overflow-x: auto;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

.admin-table th,
.admin-table td {
    padding: 15px 20px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
    font-size: 14px;
}

.admin-table th {
    background: #f8fafc;
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.admin-table tr:last-child td {
    border-bottom: none;
}

.admin-table tbody tr:hover {
    background: #f8fafc;
}

.table-empty {
    text-align: center !important;
    color: #64748b;
    padding: 40px !important;
}


/* Logout */

.admin-logout {
    margin-top: 25px;
    text-align: right;
}


/* Responsive */

@media (max-width: 1000px) {

    .dashboard-stats {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 700px) {

    .admin-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    .admin-actions {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 500px) {

    .dashboard-stats {
        grid-template-columns: 1fr;
    }

    .admin-section-header {
        align-items: flex-start;
        gap: 15px;
        flex-direction: column;
    }

}